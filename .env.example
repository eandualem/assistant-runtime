# Lovely Assistant Configuration
# Copy to .env and fill in values

# Application
APP_NAME=lovely-assistant
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here

# Alternative: JSON provider config (overrides individual env vars)
# LLM__PROVIDERS_JSON=[{"provider":"anthropic","api_key":"sk-ant-..."}]

# Model overrides (optional — defaults to anthropic:claude-haiku-4-5)
# LLM__PRIMARY_MODEL=anthropic:claude-sonnet-4-5
# LLM__SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5

# Image/Video generation providers (optional)
# FAL_KEY=your-fal-key-here
# RUNWAYML_API_SECRET=your-runway-key-here
# LUMAAI_API_KEY=your-luma-key-here

# Database
DATABASE__HOST=localhost
DATABASE__PORT=5434
DATABASE__USER=lovely_assistant
DATABASE__PASSWORD=lovely_assistant
DATABASE__NAME=lovely_assistant

# GitHub API (required for issue management tools)
GITHUB_TOKEN=ghp_your-token-here

# Backbone API (required for meeting and schedule tools)
BACKBONE_URL=http://127.0.0.1:9877
# BACKBONE_API_KEY=your-key-here
