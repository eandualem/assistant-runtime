# Assistant Runtime configuration
# Copy to .env and fill in values

# Application
APP_NAME=assistant-runtime
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# LLM Providers (at least one usable auth path required)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here
# CEREBRAS_API_KEY=your-key-here

# Alternative: JSON provider config (overrides individual env vars)
# LLM__PROVIDERS_JSON=[{"provider":"anthropic","api_key":"sk-ant-..."}]

# Debug events on the socket (system prompt, history, tool selection). Off by default;
# enable for a trusted dashboard on localhost.
# STREAMING__EMIT_DEBUG_EVENTS=true

# Access (see docs/access.md). Defaults suit one person on localhost: every caller is the
# operator and only browser pages served from this machine may call the runtime.
# ACCESS__MODE=trusted_local                 # header | host for several people
# ACCESS__CORS_ORIGINS=["https://app.example.com"]   # exact origins (JSON list)
# ACCESS__CORS_ORIGIN_REGEX=                 # clear the localhost default when exposing
# ACCESS__LOCAL_TOKEN=change-me              # bearer token required in trusted_local
# STREAMING__CLIENT_ERROR_DETAIL=false       # hide exception text from clients
# ASSISTANT__REQUEST_MODELS=["anthropic:claude-sonnet-5"]   # models a request may pick

# Model overrides (optional — defaults to anthropic:claude-opus-5 / anthropic:claude-haiku-4-5)
# LLM__PRIMARY_MODEL=anthropic:claude-sonnet-5
# LLM__SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5

# OpenAI ChatGPT/Codex OAuth (optional — local personal-use auth via ChatGPT/Codex sign-in)
# Routes openai: models allowed by your subscription; account access is checked by the backend.
# This does not create a reusable OPENAI_API_KEY.
# Preferred path: initiate device auth via /api/oauth/openai/device-code and complete the browser step.
# Optional fallback: sync an existing Codex CLI session via /api/oauth/openai/codex-cli/sync.
# If both OAuth and OPENAI_API_KEY are set, OAuth is used for supported Codex-backed chat models.
# Other OpenAI API-backed features still use OPENAI_API_KEY.
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OAUTH__ENCRYPTION_KEY=your-fernet-key-here
# LLM__CODEX_ONLY=true                       # openai: models only through the subscription; other providers unaffected
# LLM__CODEX_SERVICE_TIER=fast               # startup default for the codex_service_tier tunable
# ASSISTANT__REQUEST_SERVICE_TIER=false      # pin the tier; requests cannot ask for fast
# ASSISTANT__SUBAGENT_MODEL=cerebras:qwen-3.8-27b
# ASSISTANT__SUBAGENT_THINKING_BUDGET=2000
# LLM__PRIMARY_MODEL=openai:gpt-5.6-sol
# LLM__SUMMARIZATION_MODEL=openai:gpt-5.6-luna

# Image/Video generation providers (optional; video needs `uv sync --extra video`)
# RUNWAYML_API_SECRET=your-runway-key-here
# LUMAAI_API_KEY=your-luma-key-here

# Database (optional: without a reachable Postgres, sessions and settings stay in memory
# and the bundled default prompt artifacts are used)
DATABASE__HOST=localhost
DATABASE__PORT=5434
DATABASE__USER=assistant_runtime
DATABASE__PASSWORD=assistant_runtime
DATABASE__NAME=assistant_runtime

# GitHub API (required for issue management tools)
# GITHUB_TOKEN=ghp_your-token-here
# Repository the issue tools operate on
# GITHUB_REPO_OWNER=your-github-org
# GITHUB_REPO_NAME=your-repo

# Optional comma-separated org allowlist for the repo onboarding tools (unset = any org)
# REPO_ORGS=org-a,org-b

# Host integration (optional; see README "Host Integration"). JSON values.
# TOOLS__HOST_TOOLS={"navigate": {"description": "Open a page in the host.", "parameters": {"type": "object", "properties": {"page": {"type": "string"}}}}}
# TOOLS__HOST_TOOLS_PATH=/absolute/path/to/host_tools.json
# TOOLS__BUILTIN_TOOLS=["time", "screen", "artifacts", "subagent", "media", "video"]
# TOOLS__PROVIDER_CAPABILITIES=["notes", "issues"]  # unset = all configured; [] = none
# TOOLS__PAGE_SCOPES={"tasks": ["create_issue", "search_issues", "get_time"]}
# TOOLS__INVALIDATIONS={"create_issue": ["tasks"]}

# Optional document providers
# NOTES_PATH=~/notes                         # notes capability: a folder of markdown notes
# LIBRARY_PATHS=handbook=~/documents/handbook      # library capability: name=path,name=path

# Optional agent-backbone provider
# BACKBONE_URL=http://127.0.0.1:7120                # peers, rooms, reminders, activity, workgroups, repositories
# BACKBONE_INFRASTRUCTURE_SESSIONS=service-a,service-b   # session names that are not agents
# AGENT_STATE_DIR=~/.claude/state                 # approvals capability (agent state files)
# BACKBONE_API_KEY=your-key-here

# MCP servers (optional): copy mcp_servers.example.json to mcp_servers.json in the working
# directory, or point MCP_CONFIG_PATH at a file. No servers are started otherwise.
# MCP_CONFIG_PATH=/absolute/path/to/mcp_servers.json

# Telegram tools (optional)
# TELEGRAM_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here

# Name of the human operator, used in agent reply envelopes (optional)
# ASSISTANT_OPERATOR_NAME=operator

# Langfuse — LLM observability (optional; needs `uv sync --extra tracing`, disabled if not set)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_USER_ID=operator

# GPT-Live voice (optional; install [voice], disabled by default)
# VOICE__ENABLED=true
# VOICE__DELEGATION_ENABLED=true  # false enforces conversation-only calls
# OPENAI_API_KEY=your-api-key-here   # required for voice even with a Codex backend
# VOICE__MODEL=gpt-live-1
# VOICE__VOICE=marin
# VOICE__API_KEY_ENV=OPENAI_API_KEY
# VOICE__INSTRUCTIONS=You are a helpful voice assistant. Delegate tasks to the backend.
# VOICE__CONVERSATION_INSTRUCTIONS=You are a helpful voice assistant. Keep spoken replies concise.
# VOICE__INSTRUCTIONS_FILE=/path/to/live-instructions.md          # file contents replace the inline text
# VOICE__CONVERSATION_INSTRUCTIONS_FILE=/path/to/live-instructions.md
# VOICE__MAX_SESSIONS=4
# VOICE__MAX_DURATION_SECONDS=1800
# VOICE__CONNECT_TIMEOUT_SECONDS=20
# VOICE__CLOSE_TIMEOUT_SECONDS=10
# VOICE__MAX_TRANSCRIPT_CHARS=200000
# VOICE__CONTEXT_CHARS=16000
# VOICE__RETAINED_CALLS=100
# VOICE__EVENT_BUFFER_SIZE=512
